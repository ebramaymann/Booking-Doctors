@model IEnumerable<Doctor> 

<h1>Book Appointment</h1>
<div class="row">
    <div class="container mb-4">
        <form class="row g-3 align-items-end">

            <div class="col-md-3">
                <label for="searchName" class="form-label">Search by Name</label>
                <input type="text" class="form-control" id="searchName" name="doctorName" placeholder="Enter doctor or patient name">
            </div>

            <div class="col-md-3">
                <label for="specialization" class="form-label">Specialization</label>
                <select class="form-select" id="specialization" name="Specialization">
                    <option value="">All Specializations</option>
                    @{
                        if (ViewData["spicializations"] is List<string> spicializationsList)
                        {
                            foreach (var item in spicializationsList)
                            {
                                <option value="@item" >@item</option>
                            }

                        }
                        else
                        {
                            <option value="">No Specializations Available</option>
                        }
                    }

                   
                    
                   
                    
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>

    @foreach (var item in Model)
    {
    <div class="col-md-4 mb-4">
        <div class="card">
            <img class="card-img" src="~/Images/@item.Img" style="width: 100%; height: auto;" alt="Doctor Image">
            <div class="card-body">
                <h5 class="card-title">@item.Name</h5>
                <p class="card-text">Specialization: @item.Specialization</p>
                <a href="/Doctor/Booking/@item.Id" class="btn btn-primary">Book Appointment</a>
            </div>
        </div>
    </div>
    }
</div>